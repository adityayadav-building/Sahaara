# Copy to .env and fill in. Keep comments on their own lines (no trailing # comments).

# --- LLM: groq | gemini | ollama | openai_compat | mock ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_PROVIDER=mock
LLM_MAX_TOKENS=260
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Retrieval: dense embeddings from Ollama (run: ollama pull bge-m3, then python backend/scripts/build_index.py) ---
EMBED_MODEL=bge-m3

# --- Gnani voice ---
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_SPEED=0.95
GNANI_TTS_SAMPLE_RATE=48000
